{{ ansible_managed | comment }}
# Environment for the teleport systemd unit (read via EnvironmentFile).
{% if teleport_https_proxy | length %}
HTTPS_PROXY={{ teleport_https_proxy }}
{% endif %}
{% if teleport_http_proxy | length %}
HTTP_PROXY={{ teleport_http_proxy }}
{% endif %}
{% if teleport_no_proxy | length %}
NO_PROXY={{ teleport_no_proxy }}
{% endif %}
{% for key, value in teleport_env_extra.items() %}
{{ key }}={{ value }}
{% endfor %}
