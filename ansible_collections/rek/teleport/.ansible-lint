---
profile: production

# community.hashi_vault is an OPTIONAL dependency (only the teleport_proxy
# 'openbao' TLS provider uses it). Treat its module as known so lint doesn't
# flag it when the collection isn't installed.
mock_modules:
  - community.hashi_vault.vault_pki_generate_certificate

exclude_paths:
  - .cache/
  - .ansible/

# These templates intentionally render Teleport YAML; skip schema checks on
# rendered output and allow the documented variable-naming convention.
skip_list:
  - var-naming[no-role-prefix]  # shared teleport_* vars are read across roles

warn_list:
  - experimental
